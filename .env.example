# Copie este arquivo para .env e preencha com os seus valores.
# .env nunca é commitado (veja .gitignore).

# Opcional. De onde vêm as notas: banco (padrão) ou memoria.
#  - banco: guarda as notas no Postgres do Bimo (exige DATABASE_URL e
#    USER_ID_PADRAO, mais abaixo). Aceita leitura e escrita com histórico.
#  - memoria: notas de exemplo na memória do servidor, só para desenvolvimento
#    e testes. É recusada em produção.
# A fonte "github" foi removida; um valor antigo dá erro de configuração.
NOTAS_FONTE=

# Obrigatório. String de conexão do Supabase Postgres via transaction pooler
# (porta 6543) — usada em runtime pela aplicação (compatível com funções
# serverless).
DATABASE_URL=

# Obrigatório para rodar as migrações. Mesma credencial acima, mas via session
# pooler (porta 5432) — usada só pelo drizzle-kit (migrations/DDL). O
# transaction pooler não suporta prepared statements nem é recomendado pra DDL.
DATABASE_URL_MIGRATIONS=

# URL do projeto Supabase — painel do projeto > Project Settings > Data API.
# Usada pelas Fontes (Storage) e pelos testes de integração.
SUPABASE_URL=

# Service role key do Supabase — painel do projeto > Project Settings > API
# Keys. Só usada no servidor (nunca chega ao cliente) para gravar Fontes no
# Storage e para os testes de integração criarem um usuário efêmero.
SUPABASE_SERVICE_ROLE_KEY=

# Obrigatório. UUID do usuário no Supabase Auth, dono de todas as notas e
# Fontes — provisório, até o login multiusuário. Crie um usuário via painel
# (Authentication > Users) ou API admin e cole o UUID gerado aqui.
USER_ID_PADRAO=

# Obrigatório. Hash da senha de acesso (scrypt:<salt>:<hash>); gere com
# `npm run gerar-senha`. Sem ele, o login recusa tudo (503).
SENHA_HASH=

# Obrigatório. Chave (32+ caracteres) que assina o cookie de sessão; gere com
# `npm run gerar-segredo`. Girar este valor encerra todas as sessões.
SEGREDO_SESSAO=

# Obrigatório para o chat. Chave da API OpenAI, usada somente no servidor.
# Configure também no ambiente de hospedagem; nunca use NEXT_PUBLIC_ nesta chave.
OPENAI_API_KEY=

# Opcional. Modelo do agente principal do chat. Padrão: gpt-6-luna.
OPENAI_MODEL=gpt-6-luna

# Opcional. Habilita os metadados da Wiki Viva após aplicar a migração 0007_wiki_viva.
WIKI_VIVA_ATIVA=0

# Automação integrada. Exige também a migração 0008_wiki_automatica e WIKI_VIVA_ATIVA=1.
# Notas salvas alimentam a fila; configure o executor independente para retomada contínua.
WIKI_AUTOMATICA_ATIVA=0

# Teto diário por dono, em tokens (UTC). Não representa valor em reais.
# O servidor reserva antes de chamar; consumo incerto permanece comprometido.
WIKI_TETO_TOKENS_DIA=200000

# Segredo exclusivo do executor, 32+ caracteres; nunca use NEXT_PUBLIC_ nem reutilize o da sessão.
WIKI_EXECUTOR_SEGREDO=

# Endereço da aplicação para `npm run wiki:executar`; HTTPS obrigatório fora de localhost.
BIMO_URL=http://localhost:3000

# Obrigatório para rascunhos no editor e para o pipeline de ingestão.
# Chave da API do Gemini. Crie em:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional. Modelo do Gemini a usar. Padrão: gemini-3.5-flash
GEMINI_MODEL=
