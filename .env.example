# Copie este arquivo para .env e preencha com os seus valores.
# .env nunca é commitado (veja .gitignore).

# Obrigatório. Repositório do GitHub onde fica o seu vault do Obsidian.
# Formato: dono/repositorio
VAULT_REPO=seu-usuario/seu-vault

# Obrigatório. Personal Access Token do GitHub com permissão de leitura
# (e, nas próximas etapas, escrita) no repositório acima.
# Crie em: https://github.com/settings/tokens
GITHUB_TOKEN=

# Opcional. Branch a ser lida. Padrão: main
VAULT_BRANCH=main

# Opcional. Se as notas não estiverem na raiz do repositório, informe a
# subpasta aqui (sem barra no início ou no fim). Padrão: raiz do repo.
VAULT_SUBPATH=

# Obrigatório (Fase 2 - Knowledge Core). String de conexão do Supabase
# Postgres via transaction pooler (porta 6543) — usada em runtime pela
# aplicação (compatível com funções serverless).
DATABASE_URL=

# Obrigatório (Fase 2 - Knowledge Core). Mesma credencial acima, mas via
# session pooler (porta 5432) — usada só pelo drizzle-kit (migrations/DDL).
# O transaction pooler não suporta prepared statements nem é recomendado
# pra DDL.
DATABASE_URL_MIGRATIONS=
